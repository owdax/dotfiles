#!/usr/bin/env bash
# macOS preferences for a fresh Mac. Based on https://mths.be/macos, updated
# for macOS 26 (Tahoe) on Apple Silicon.
#
# Usage: bash .macos [--dry-run]
#   --dry-run  print every command instead of running it
#
# Some changes need a logout/restart to take full effect.
set -uo pipefail

DRY_RUN=0
case "${1:-}" in
  --dry-run) DRY_RUN=1 ;;
  "") ;;
  *) echo "usage: $0 [--dry-run]" >&2; exit 2 ;;
esac

run() {
  if (( DRY_RUN )); then
    printf '  %s\n' "$*"
  elif ! "$@"; then
    echo "  FAILED: $*" >&2
  fi
}

section() { printf '\n== %s\n' "$1"; }

if (( DRY_RUN )); then
  echo "Dry run: nothing will be changed."
else
  # Close System Settings so it doesn't overwrite what we change.
  osascript -e 'tell application "System Settings" to quit' 2>/dev/null
  # Ask for the admin password upfront and keep sudo alive until we finish.
  sudo -v
  while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &
fi

###############################################################################
section "General UI/UX"
###############################################################################

# Mute the startup chime (Apple Silicon: StartupMute replaced SystemAudioVolume).
run sudo nvram StartupMute=%01

# Sidebar icon size: medium.
run defaults write NSGlobalDomain NSTableViewDefaultSizeMode -int 2
# No delay before the toolbar title rollover.
run defaults write NSGlobalDomain NSToolbarTitleViewRolloverDelay -float 0
# Faster window resize animation for Cocoa apps.
run defaults write NSGlobalDomain NSWindowResizeTime -float 0.001

# Expand save and print panels by default.
run defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode -bool true
run defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode2 -bool true
run defaults write NSGlobalDomain PMPrintingExpandedStateForPrint -bool true
run defaults write NSGlobalDomain PMPrintingExpandedStateForPrint2 -bool true

# Save to disk (not iCloud) by default.
run defaults write NSGlobalDomain NSDocumentSaveNewDocumentsToCloud -bool false
# Quit the printer app when print jobs complete.
run defaults write com.apple.print.PrintingPrefs "Quit When Finished" -bool true

###############################################################################
section "Keyboard and input"
###############################################################################

# Keyboard navigation: Tab moves focus between all controls.
# (2 on macOS 14+; the old value 3 no longer applies.)
run defaults write NSGlobalDomain AppleKeyboardUIMode -int 2
# Key repeat instead of the accent popup when holding a key.
run defaults write NSGlobalDomain ApplePressAndHoldEnabled -bool false
# Very fast key repeat (faster than System Settings allows).
run defaults write NSGlobalDomain KeyRepeat -int 1
run defaults write NSGlobalDomain InitialKeyRepeat -int 10

# Show the input (language) menu on the login screen.
run sudo defaults write /Library/Preferences/com.apple.loginwindow showInputMenu -bool true

###############################################################################
section "Energy"
###############################################################################

# Only touch settings this Mac supports (Apple Silicon lacks e.g. standbydelay),
# and never disable hibernation: on a laptop that loses all unsaved work if the
# battery dies while asleep.
PM_CAPS=$(pmset -g cap 2>/dev/null)
pm() { # pm <-a|-b|-c> <setting> <value>
  if grep -qw -- "$2" <<<"$PM_CAPS"; then
    run sudo pmset "$1" "$2" "$3"
  else
    echo "  skip: pmset $2 not supported on this Mac"
  fi
}

if pmset -g batt | grep -q InternalBattery; then
  echo "  laptop profile"
  pm -b displaysleep 5    # battery: display off after 5 min
  pm -b sleep 15          #          sleep after 15 min
  pm -c displaysleep 15   # charger: display off after 15 min
  pm -c sleep 0           #          never sleep
else
  echo "  desktop profile"
  pm -a displaysleep 30
  pm -a sleep 0
fi

###############################################################################
section "Screen"
###############################################################################

# Require the password immediately after sleep/screen saver. The old
# com.apple.screensaver askForPassword keys are ignored since macOS 10.13;
# sysadminctl prompts for your password once.
if (( DRY_RUN )); then
  run sysadminctl -screenLock immediate -password -
else
  sysadminctl -screenLock immediate -password - || echo "  FAILED: screen lock delay" >&2
fi

###############################################################################
section "Screenshots"
###############################################################################

run mkdir -p "$HOME/Screenshots"
run defaults write com.apple.screencapture location -string "$HOME/Screenshots"
run defaults write com.apple.screencapture type -string "png"
run defaults write com.apple.screencapture disable-shadow -bool true

###############################################################################
section "Finder"
###############################################################################

run defaults write com.apple.finder DisableAllAnimations -bool true
run defaults write com.apple.finder AppleShowAllFiles -bool true
run defaults write NSGlobalDomain AppleShowAllExtensions -bool true
run defaults write com.apple.finder ShowPathbar -bool true
# Full POSIX path as the window title.
run defaults write com.apple.finder _FXShowPosixPathInTitle -bool true
# Folders first when sorting by name.
run defaults write com.apple.finder _FXSortFoldersFirst -bool true
# Search the current folder by default.
run defaults write com.apple.finder FXDefaultSearchScope -string "SCcf"
run defaults write com.apple.finder FXEnableExtensionChangeWarning -bool false
# Spring-loaded folders, no delay.
run defaults write NSGlobalDomain com.apple.springing.enabled -bool true
run defaults write NSGlobalDomain com.apple.springing.delay -float 0
# No .DS_Store files on network or USB volumes.
run defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool true
run defaults write com.apple.desktopservices DSDontWriteUSBStores -bool true
# List view by default (others: icnv, clmv, glyv).
run defaults write com.apple.finder FXPreferredViewStyle -string "Nlsv"
run defaults write com.apple.finder WarnOnEmptyTrash -bool false
# Show ~/Library and /Volumes.
run chflags nohidden "$HOME/Library"
run sudo chflags nohidden /Volumes
# Expand General, Open with, and Sharing & Permissions in Get Info.
run defaults write com.apple.finder FXInfoPanesExpanded -dict \
  General -bool true OpenWith -bool true Privileges -bool true

###############################################################################
section "Dock and hot corners"
###############################################################################

run defaults write com.apple.dock mineffect -string "scale"
run defaults write com.apple.dock minimize-to-application -bool true
run defaults write com.apple.dock enable-spring-load-actions-on-all-items -bool true
run defaults write com.apple.dock show-process-indicators -bool true
run defaults write com.apple.dock launchanim -bool false
# Auto-hide with no delay and a fast animation.
run defaults write com.apple.dock autohide -bool true
run defaults write com.apple.dock autohide-delay -float 0
run defaults write com.apple.dock autohide-time-modifier -float 0.5
# Translucent icons for hidden apps; no recent apps section.
run defaults write com.apple.dock showhidden -bool true
run defaults write com.apple.dock show-recents -bool false

# Hot corner values: 0 none, 2 Mission Control, 3 app windows, 4 Desktop,
# 5 start screen saver, 6 disable screen saver, 10 display sleep,
# 11 Apps (was Launchpad before macOS 26), 12 Notification Center, 13 Lock Screen.
# Bottom left → Apps.
run defaults write com.apple.dock wvous-bl-corner -int 11
run defaults write com.apple.dock wvous-bl-modifier -int 0

# Put Simulator in /Applications so the Apps view and Spotlight list it.
SIMULATOR="/Applications/Xcode.app/Contents/Developer/Applications/Simulator.app"
if [[ -d $SIMULATOR ]]; then
  run sudo ln -sfn "$SIMULATOR" /Applications/Simulator.app
fi

###############################################################################
section "Safari"
###############################################################################

# Safari is sandboxed: its prefs live in ~/Library/Containers and can only be
# written by a terminal with Full Disk Access.
SAFARI_PREFS="$HOME/Library/Containers/com.apple.Safari/Data/Library/Preferences"
if ls "$SAFARI_PREFS" >/dev/null 2>&1; then
  # Privacy: don't send search queries to Apple.
  run defaults write com.apple.Safari UniversalSearchEnabled -bool false
  run defaults write com.apple.Safari SuppressSearchSuggestions -bool true
  run defaults write com.apple.Safari ShowFullURLInSmartSearchField -bool true
  # Don't open "safe" files after downloading.
  run defaults write com.apple.Safari AutoOpenSafeDownloads -bool false
  # Debug and Develop menus, Web Inspector.
  run defaults write com.apple.Safari IncludeInternalDebugMenu -bool true
  run defaults write com.apple.Safari IncludeDevelopMenu -bool true
  run defaults write com.apple.Safari WebKitDeveloperExtrasEnabledPreferenceKey -bool true
  run defaults write com.apple.Safari com.apple.Safari.ContentPageGroupIdentifier.WebKit2DeveloperExtrasEnabled -bool true
  run defaults write com.apple.Safari WarnAboutFraudulentWebsites -bool true
  run defaults write com.apple.Safari InstallExtensionUpdatesAutomatically -bool true
else
  echo "  skip: give your terminal Full Disk Access (System Settings → Privacy &"
  echo "        Security → Full Disk Access), then re-run to apply Safari settings"
fi
# Web Inspector context menu in web views (not sandboxed).
run defaults write NSGlobalDomain WebKitDeveloperExtras -bool true

###############################################################################
section "Apps"
###############################################################################

# Terminal.app: UTF-8 only.
run defaults write com.apple.terminal StringEncodings -array 4
# Time Machine: don't offer new disks as backup volumes.
run defaults write com.apple.TimeMachine DoNotOfferNewDisksForBackup -bool true
# Activity Monitor: open main window, CPU graph in the Dock, all processes,
# sorted by CPU.
run defaults write com.apple.ActivityMonitor OpenMainWindow -bool true
run defaults write com.apple.ActivityMonitor IconType -int 5
run defaults write com.apple.ActivityMonitor ShowCategory -int 0
run defaults write com.apple.ActivityMonitor SortColumn -string "CPUUsage"
run defaults write com.apple.ActivityMonitor SortDirection -int 0
# QuickTime: auto-play videos when opened.
run defaults write com.apple.QuickTimePlayerX MGPlayMovieOnOpen -bool true
# Photos: don't open when a device is plugged in.
run defaults -currentHost write com.apple.ImageCapture disableHotPlug -bool true
# Chrome: expand the print dialog.
run defaults write com.google.Chrome PMPrintingExpandedStateForPrint2 -bool true

###############################################################################
section "Software updates"
###############################################################################

# These are system-wide; the per-user com.apple.SoftwareUpdate keys are ignored.
SU=/Library/Preferences/com.apple.SoftwareUpdate
run sudo defaults write "$SU" AutomaticCheckEnabled -bool true
run sudo defaults write "$SU" AutomaticDownload -bool true
# Security responses and system data files.
run sudo defaults write "$SU" CriticalUpdateInstall -bool true
run sudo defaults write "$SU" ConfigDataInstall -bool true
# App Store app updates.
run sudo defaults write /Library/Preferences/com.apple.commerce AutoUpdate -bool true

###############################################################################
section "Restart affected apps"
###############################################################################

for app in "Activity Monitor" "cfprefsd" "Dock" "Finder" "Google Chrome" \
  "Photos" "Safari" "SystemUIServer" "Terminal"; do
  if (( DRY_RUN )); then
    printf '  killall %q\n' "$app"
  else
    killall "$app" &>/dev/null
  fi
done

echo
echo "Done. Some changes need a logout/restart to take effect."
