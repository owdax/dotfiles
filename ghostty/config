# Config syntax crash course
# ==========================
# # The config file consists of simple key-value pairs,
# # separated by equals signs.
# font-family = Iosevka
# window-padding-x = 2
#
# # Spacing around the equals sign does not matter.
# # All of these are identical:
# key=value
# key= value
# key =value
# key = value
#
# # Any line beginning with a # is a comment. It's not possible to put
# # a comment after a config option, since it would be interpreted as a
# # part of the value. For example, this will have a value of "#123abc":
# background = #123abc
#
# # Empty values are used to reset config keys to default.
# key =
#
# # Some config options have unique syntaxes for their value,
# # which is explained in the docs for that config option.
# # Just for example:
# resize-overlay-duration = 4s 200ms
# macos-titlebar-proxy-icon = visible
#
#
# # Copy Ghostty's terminfo entry to the remote machine. The easiest way is using the following # # one-liner:
# infocmp -x xterm-ghostty | ssh YOUR-SERVER -- tic -x -
cursor-style = block
shell-integration-features = no-cursor
# Hidden titlebar for yabai tiling (was "tabs" under AeroSpace for native tabs).
# Drag windows with option+click on the frame; top-edge dragging is gone.
macos-titlebar-style = hidden
theme = 0x96f

# Spread the sub-cell remainder across all edges instead of parking it on one
# side, so the margin stops visibly flipping when switching tabs under AeroSpace.
window-padding-balance = true

# AeroSpace keeps Ghostty floating (native tabs appear as separate windows to the
# macOS accessibility API, so tiling them re-splits the column on every new tab).
# Opening maximized means floating already fills the screen -- no manual
# alt+shift+; f unfloat and no mouse resize.
# Do NOT use window-width/window-height here: overriding those triggers a
# self-resize on new tab (https://github.com/ghostty-org/ghostty/issues/11313).
maximize = true
